# Copy to .env (never commit it). Only the backend reads these; nothing is sent to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# Pipedrive: each user connects their own account through Pipedrive's official MCP server (OAuth). No API key.
BASE_URL=https://crm.yethu-aung.dev
# Encrypts stored Pipedrive tokens. Generate once: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it later disconnects everyone (they reconnect).
SECRET_KEY=
# PIPEDRIVE_MCP_URL=https://mcp.pipedrive.ai/mcp
# Only if the server ever stops offering dynamic client registration:
# PIPEDRIVE_MCP_CLIENT_ID=
# PIPEDRIVE_MCP_CLIENT_SECRET=

# Google (Gmail, Drive, Calendar): each user connects their own account, read-only scopes. Google Cloud OAuth client
# of type "Web application" with redirect URI {BASE_URL}/oauth/google/callback. Leave GOOGLE_ENABLED=false until the
# team agrees email and document content may be sent to DeepSeek.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refuse requests that didn't come through Cloudflare Access (keep true on the server).
REQUIRE_ACCESS_EMAIL=true

# Optional
# SKILL_DIRS=skills/komosion-skills:skills-local
# ALWAYS_LOADED_SKILLS=evidence-discipline
# MAX_TOOL_STEPS=10
# TOOL_RESULT_CHARS=12000
