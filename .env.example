# Copy to .env (never commit it). Only the backend reads these; nothing is sent to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# Pipedrive API token of a user with the least access possible. The app only ever sends GET requests.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_BASE_URL=https://api.pipedrive.com

# Optional
# SKILL_DIRS=skills/komosion-skills:skills-local
# ALWAYS_LOADED_SKILLS=evidence-discipline
# MAX_TOOL_STEPS=10
# TOOL_RESULT_CHARS=12000
